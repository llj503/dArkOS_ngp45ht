+    * Reject anything that isn't stereo here rather than risk a
+    * stack overflow during mix.  Mono should be fixed
+    * separately by adjusting the mixer's per-channel
+    * accounting. */
+   if (dr_flac->channels != 2)
+   {
+      drflac_close(dr_flac);
+      return false;
+   }
