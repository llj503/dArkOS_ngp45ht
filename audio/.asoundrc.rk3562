# RK3562 audio configuration (RK817 codec)
# Card 0: rockchiprk817 (speaker/headphone)
# Card 1: rockchiphdmirk628 (HDMI audio via RK628)

pcm.!default {
        type            plug
        slave.pcm       "softvol"
}

ctl.!default {
        type            hw
        card            0
}

pcm.ddmix {
        # One dmix for all users (no ipc_key_add_uid), open to all: ports run
        # as root (runport.sh) share it with ES and fluidsynth running as ark.
        # A per-user dmix would make the second one find the card busy, and a
        # 0600 one created by root would lock ark out.
        ipc_key         1024
        ipc_perm        0666
        type            dmix
        slave {
                pcm         "hw:0,0"
                period_time 0
                period_size 1024
                buffer_size 4096
                rate 44100
        }
}

pcm.softvol {
        type            softvol
        slave {
                pcm         "ddmix"
        }
        control {
                name        "Master"
                card        0
        }
}
