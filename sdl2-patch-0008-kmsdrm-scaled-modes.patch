+/* Scaled modes: the RGA pass that rotates each frame onto the portrait panel
+   scales it as well. The source rectangle is the GBM surface (landscape, the
+   size the app asked for); the destination is the part of the panel it fills,
+   keeping the aspect ratio, so a 4:3 mode gets black bars at the sides. With
+   ROT_90 a landscape x offset becomes a portrait y offset; the picture is
+   centred, so the direction of the turn does not matter. */
+static void
+KMSDRM_UpdateRotateRects(_THIS)
+{
+    SDL_VideoData *viddata = ((SDL_VideoData *)_this->driverdata);
+    int pw = viddata->rga_panel_w, ph = viddata->rga_panel_h;
+    int sw = viddata->rga_src_w, sh = viddata->rga_src_h;
+    int tw, th, i;
+
+    if (!pw || !ph || !sw || !sh) {
+        return;
+    }
+    if ((long)sw * ph >= (long)sh * pw) {
+        tw = pw;
+        th = (int)(((long)pw * sh / sw) & ~1L);
+    } else {
+        th = ph;
+        tw = (int)(((long)ph * sw / sh) & ~1L);
+    }
+    if (ph - th < 4) {
+        th = ph;  /* 854x480 and the like: within a few lines, fill */
+    }
+    if (pw - tw < 4) {
+        tw = pw;
+    }
+
+    /* the stride is set per frame from the buffer itself */
+    rga_set_rect(&src_info.rect, 0, 0, sw, sh, sw, sh, RK_FORMAT_BGRA_8888);
+    rga_set_rect(&dst_info.rect, (ph - th) / 2, (pw - tw) / 2, th, tw, ph, pw, RK_FORMAT_BGRA_8888);
+
+    /* black bars: the blit never writes outside its rectangle, so clear the
+       scanout buffers once whenever the picture does not fill the panel */
+    if (tw != pw || th != ph) {
+        for (i = 0; i < RGA_BUFFERS_MAX; ++i) {
+            rga_info_t fill;
+            SDL_zero(fill);
+            fill.fd = viddata->rga_buffer_prime_fds[i];
+            fill.mmuFlag = 1;
+            fill.color = 0xff000000;
+            rga_set_rect(&fill.rect, 0, 0, ph, pw, ph, pw, RK_FORMAT_BGRA_8888);
+            if (fill.fd > 0 && c_RkRgaColorFill(&fill) < 0) {
+                SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "Failed to clear the RGA buffer");
+            }
+        }
+    }
+}
+
